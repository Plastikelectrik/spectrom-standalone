# SPECTROM standalone — copy this file to .env and change what you need.

# Web page and API. SPECTROM has no login: keep 127.0.0.1 (only this computer).
HOST=127.0.0.1
PORT=8484

# Internal port of the agent (hunts, tests, catalogue). Change it only if 8240 is taken.
SPECTROM_AGENT_PORT=8240

# Where the catalogue, the ZXDB index, the downloaded games and your saved games are kept.
SPECTROM_DATA=data

# Optional local AI (Ollama) to plan hunts and write game sheets. Without it SPECTROM uses simple rules.
SPECTROM_OLLAMA=http://127.0.0.1:11434
# SPECTROM_MODEL=qwen2.5:1.5b

# 🌐 ONLINE tab (optional multiplayer network). Nothing connects until you press CONNECT in that tab. off = hide the tab.
# SPECTROM_ONLINE=https://plastikelectrik.xyz/spectrom.php
